@using WebDBA.Models.ViewModels
@model WorkerFormViewModel

@{
    ViewData["Title"] = "Добавление сотрудника";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-plus"></i> Добавление сотрудника</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- ID -->
                        <div class="mb-3">
                            <label asp-for="CreateDto!.Id" class="form-label fw-bold"></label>
                            <input asp-for="CreateDto!.Id" class="form-control" placeholder="Например: W00001" />
                            <span asp-validation-for="CreateDto!.Id" class="text-danger"></span>
                            <div class="form-text">Уникальный идентификатор сотрудника (6 символов, заглавные буквы и цифры)</div>
                        </div>

                        <!-- Full name -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="CreateDto!.Name" class="form-label fw-bold"></label>
                                <input asp-for="CreateDto!.Name" class="form-control" placeholder="Иван" />
                                <span asp-validation-for="CreateDto!.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CreateDto!.Surname" class="form-label fw-bold"></label>
                                <input asp-for="CreateDto!.Surname" class="form-control" placeholder="Иванов" />
                                <span asp-validation-for="CreateDto!.Surname" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CreateDto!.Patronymic" class="form-label fw-bold"></label>
                                <input asp-for="CreateDto!.Patronymic" class="form-control" placeholder="Иванович" />
                                <span asp-validation-for="CreateDto!.Patronymic" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Gender and Date of birth -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateDto!.Gender" class="form-label fw-bold"></label>
                                <select asp-for="CreateDto!.Gender" asp-items="Model.Genders" class="form-select">
                                    <option value="">-- Выберите --</option>
                                </select>
                                <span asp-validation-for="CreateDto!.Gender" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateDto!.DateOfBirth" class="form-label fw-bold"></label>
                                <input asp-for="CreateDto!.DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="CreateDto!.DateOfBirth" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Phone and Email Address -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateDto!.Phone" class="form-label fw-bold"></label>
                                <input asp-for="CreateDto!.Phone" class="form-control" placeholder="+7 (999) 123-45-67" />
                                <span asp-validation-for="CreateDto!.Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateDto!.Email" class="form-label fw-bold"></label>
                                <input asp-for="CreateDto!.Email" class="form-control" type="email" placeholder="example@mail.com" />
                                <span asp-validation-for="CreateDto!.Email" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Position and Division -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateDto!.PositionId" class="form-label fw-bold"></label>
                                <select asp-for="CreateDto!.PositionId" asp-items="Model.Positions" class="form-select">
                                    <option value="">-- Выберите должность --</option>
                                </select>
                                <span asp-validation-for="CreateDto!.PositionId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateDto!.ArrivedAt" class="form-label fw-bold"></label>
                                <select asp-for="CreateDto!.ArrivedAt" asp-items="Model.StructuralUnits" class="form-select">
                                    <option value="">-- Выберите подразделение --</option>
                                </select>
                                <span asp-validation-for="CreateDto!.ArrivedAt" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Photo -->
                        <div class="mb-3">
                            <label asp-for="CreateDto!.Photo" class="form-label fw-bold"></label>
                            <input type="file" name="photoFile" class="form-control" accept="image/*" />
                            <div class="form-text">Загрузите фотографию (опционально)</div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Сохранить
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}