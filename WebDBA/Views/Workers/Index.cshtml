@using WebDBA.Models.ViewModels
@model WorkersIndexViewModel

@{
    ViewData["Title"] = "Сотрудники по отделам";
}

<div class="container-fluid">
    <div class="row">
        <!-- Left column: Division tree -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-diagram-3"></i> Подразделения
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="tree-container">
                        @if (Model.Tree.Any())
                        {
                            <ul class="tree">
                                @foreach (var unit in Model.Tree)
                                {
                                    <li>
                                        @await Html.PartialAsync("_UnitTreeNodePartial", unit, new ViewDataDictionary(ViewData) {
                                        { "SelectedUnitId", Model.SelectedUnitId }})
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                <p class="mb-0">Нет подразделений</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="container">
                    <div style="display: flex; justify-content: flex-end;">
                        <a href="@Url.Action("Create", "StructuralUnits")"
                           class="btn btn-primary d-flex align-items-center justify-content-center"
                           title="Добавить структурное подразделение"
                           style="width: 32px; height: 32px; padding: 0; border-radius: 4px; margin: 3px 0px;">
                            <i class="bi bi-folder-plus"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right column: List of employees -->
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-people"></i> Сотрудники
                        <span class="badge bg-light text-dark ms-2" id="workerCount">@Model.Workers.Count</span>
                    </h5>
                    <span class="badge bg-light text-dark" id="selectedUnitName">
                        @if (!string.IsNullOrEmpty(Model.SelectedUnitId))
                        {
                            @Model.Tree.FirstOrDefault(u => u.Id == Model.SelectedUnitId)?.Name
                        }
                        else
                        {
                            <text>Все</text>
                        }
                    </span>
                </div>
                <div class="card-body p-0">
                    <div id="workersTableContainer">
                        @await Html.PartialAsync("_WorkersTablePartial", Model.Workers)
                    </div>
                    <div class="container">
                        <div style="display: flex; justify-content: flex-end;">
                            <a href="@Url.Action("Create", "Workers")"
                               class="btn btn-primary d-flex align-items-center justify-content-center"
                               title="Добавить сотрудника"
                               style="width: 32px; height: 32px; padding: 0; border-radius: 4px; margin: 3px 0px;">
                                <i class="bi bi-person-plus"></i>
                            </a>
                        </div>
                     </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}