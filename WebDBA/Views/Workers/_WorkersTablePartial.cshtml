@using WebDBA.Models.DTOs
@using WebDBA.Models.DTOs.Workers
@model List<WorkerWithUnitDto>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm mb-0" id="workersTable">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Должность</th>
                    <th>Телефон</th>
                    <th>Email</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var worker in Model)
                {
                    <tr>
                        <td><strong>@worker.Id</strong></td>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (worker.Photo != null && worker.Photo.Length > 0)
                                {
                                    <div style="width: 28px; height: 28px; flex-shrink: 0; margin-right: 3px;">
                                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(worker.Photo)"
                                             alt="Фото"
                                             style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block;" />
                                    </div>
                                }
                                else
                                {
                                    @if (worker.Gender == "Женский")
                                    {
                                        <div class="mb-3" style="margin-right: 3px;">
                                            <img src="~/images/workers/women-profile-mini.png"
                                                 alt="Женский профиль"
                                                 class="rounded-circle"
                                                 style="width: 28px; height: 28px; flex-shrink: 0; font-size: 11px; font-weight: 600;">
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-3" style="margin-right: 3px;">
                                            <img src="~/images/workers/man-profile-mini.png"
                                                 alt="Мужской профиль"
                                                 class="rounded-circle"
                                                 style="width: 28px; height: 28px; flex-shrink: 0; font-size: 11px; font-weight: 600;">
                                        </div>
                                    }
                                }
                                <span>@worker.FullName</span>
                            </div>
                        </td>
                        <td>@worker.PositionName</td>
                        <td>@worker.Phone</td>
                        <td>@worker.Email</td>
                        <td style="white-space: nowrap;">
                            @if (worker.IsActive)
                            {
                                <span class="badge-status active">
                                    Активен
                                </span>
                            }
                            else
                            {
                                <span class="badge-status inactive">
                                    Уволен
                                </span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="@Url.Action("Profile", "Workers", new { id = worker.Id })"
                                   class="btn btn-primary d-inline-flex align-items-center justify-content-center"
                                   title="Профиль"
                                   style="width: 32px; height: 32px; padding: 0; border-radius: 4px; margin-right: 2px;">
                                    <i class="bi bi-person-square"></i>
                                </a>
                                @if (worker.IsActive)
                                {
                                    <a href="@Url.Action("Edit", "Workers", new { id = worker.Id })"
                                        class="btn btn-warning d-inline-flex align-items-center justify-content-center"
                                        title="Редактировать"
                                        style="width: 32px; height: 32px; padding: 0; border-radius: 4px; margin-right: 2px;">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form method="post" action="@Url.Action("Dismiss", new { id = worker.Id })"
                                            onsubmit="return confirm('Уволить сотрудника @worker.FullName?')"
                                            style="display: inline-block; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-secondary d-inline-flex align-items-center justify-content-center"
                                                title="Уволить"
                                                style="width: 32px; height: 32px; padding: 0; border: none; border-radius: 4px;">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox" style="font-size: 3rem; display: block;"></i>
        <p class="mb-0">В этом подразделении нет сотрудников</p>
    </div>
}

<script>
    document.querySelector('.card-header .badge')?.textContent = '@Model.Count';
</script>